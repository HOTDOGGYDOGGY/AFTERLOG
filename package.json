{
  "name": "afterlog",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "build:local": "tsc -p . && vite build --mode offline",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "build:collector": "vite build --config vite.collector.config.ts",
    "build:collector:test": "COLLECTOR_TEST=1 vite build --config vite.collector.config.ts"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "fflate": "0.8.3",
    "html-to-image": "1.11.13",
    "html2canvas": "1.4.1",
    "immer": "11.1.18",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/chrome": "0.3.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  },
  "collectorVersion": "0.1.3"
}
